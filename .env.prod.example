# Copy to .env.prod. This is a template, not a completed deployment.
POSTGRES_DB=istay
POSTGRES_USER=istay
POSTGRES_ADMIN_USER=istay_owner
# Resolve and record immutable image references after Docker installation.
# Production refuses to interpolate absent image references.
POSTGRES_IMAGE=
API_IMAGE=
WEB_IMAGE=
BACKUP_IMAGE=
CLOUDFLARED_IMAGE=
APP_ORIGIN=https://audit.your-domain.example
TRUSTED_HOSTS=audit.your-domain.example,localhost,127.0.0.1,api
# Same-host database backup staging only. Must additionally copy backups off this PC.
BACKUP_DIR=./backups/production
BACKUP_RETENTION_DAYS=30
